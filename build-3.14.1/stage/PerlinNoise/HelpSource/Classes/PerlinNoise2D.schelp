Examples::

code::
// A fixed horizontal slice through a 2D field.
(
{
	PerlinNoise2D.ar(110, 0, yphase: 0.35, octaves: 8, persistence: 0.5, seed: 12) * 0.15 ! 2
}.play
)
::

code::
// Scan a slow 2D path.
(
{
	PerlinNoise2D.ar(90, 0.17, xphase: 0.1, yphase: 0.4, octaves: 10, persistence: 0.55, seed: 1001) * 0.18 ! 2
}.play
)
::

code::
// Modulate octave count; changes are latched at wrap points.
(
{
	var oct = LFNoise0.kr(3).range(3, 14);
	PerlinNoise2D.ar(80, 0, yphase: MouseY.kr(0, 1), octaves: oct, persistence: 0.5, seed: 42) * 0.15 ! 2
}.play
)
::
